<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+. Only your rules and the currency → account mapping are backed up / transferred.
  Everything else stays on the phone: the Wallet token (its Keystore key is never backed up, so a
  restored copy couldn't be decrypted), the activity log, and the Wallet caches (re-fetched anyway).
  Keep in sync with backup_rules.xml (Android 11 and older).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="backup/user_rules.json" />
        <include domain="sharedpref" path="account_mapping.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backup/user_rules.json" />
        <include domain="sharedpref" path="account_mapping.xml" />
    </device-transfer>
</data-extraction-rules>
